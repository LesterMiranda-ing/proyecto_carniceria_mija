# Copia este archivo como .env y completa los valores reales.
# .env NUNCA debe subirse al control de versiones (ver .gitignore).

SECRET_KEY=cambia-esta-clave-en-produccion

DB_HOST=localhost
DB_PORT=5432
DB_NAME=carniceria_mija
DB_USER=postgres
DB_PASSWORD=postgres

# Avisos de bajo stock por WhatsApp (opcional) con CallMeBot, servicio gratuito NO oficial.
# Activación (una sola vez): copia el número del bot DESDE https://www.callmebot.com/blog/free-api-whatsapp-messages/
# (no de otra fuente), guárdalo en tu teléfono y envíale: I allow callmebot to send me messages
# Te responderá con tu apikey. Recomendado: usar WhatsApp PERSONAL (no Business) y, de ser posible,
# un número secundario: al ser un servicio no oficial no hay garantía de que WhatsApp no lo limite.
# CALLMEBOT_PHONE va en formato internacional, p. ej. +50212345678. Déjalos vacíos para desactivar los avisos.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Horas mínimas entre dos avisos del mismo producto.
ALERTA_STOCK_HORAS=6

# Primer Gerente (administrador). Se crea al arrancar solo si aún no existe un Gerente.
# La contraseña (mínimo 8 caracteres) es TEMPORAL: se te pedirá cambiarla al primer ingreso.
# Una vez creado el usuario, puedes borrar ADMIN_PASSWORD de este archivo.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador
